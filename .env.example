# ---------------------------------------------------------------------------
# Environment variables (copy to .env.local for local development)
#
# NEVER prefix a secret with NEXT_PUBLIC_ — that exposes it to the browser.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://drorklar.com

# --- Email delivery (optional; see app/api/contact/route.ts) ---
# RESEND_API_KEY=
# CONTACT_INBOX=hello@drorklar.com

# --- CRM (optional) ---
# CRM_API_KEY=
# CRM_WEBHOOK_URL=

# --- Database (optional) ---
# DATABASE_URL=
